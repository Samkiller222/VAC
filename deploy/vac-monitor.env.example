# Production settings for the VAC monitor.
# Copy to /etc/vac-monitor/vac-monitor.env (Linux) and fill in. Keep this file readable
# only by the service account: it contains the dashboard password.

# Real checks (only on the approved server inside the government network)
MOCK=0

# Private VAC list with the real VPN tunnel endpoints (host + port per VAC). Never commit it.
OFFICES_FILE=/etc/vac-monitor/offices.json

# Where check history is stored
DATA_DIR=/var/lib/vac-monitor

# Check every 5 minutes; a VAC is offline after 3 failed checks in a row
INTERVAL_MS=300000
TIMEOUT_MS=5000
FAIL_THRESHOLD=3

# Dashboard port (behind the HTTPS reverse proxy, so not exposed directly)
PORT=3000

# Dashboard login - set both
DASH_USER=
DASH_PASS=

# Test menu: off in production (it is also automatically off when MOCK=0)
TEST_MENU=0

# Optional: Teams/Slack-style webhook for OFFLINE / RECOVERED alerts
ALERT_WEBHOOK=
